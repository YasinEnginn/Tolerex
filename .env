# ================= GLOBAL =================
# Host mode default. In docker cluster use LEADER_ADDR=leader:5555
LEADER_ADDR=localhost:5555

# ================= LEADER =================
LEADER_GRPC_PORT=5555
LEADER_TCP_PORT=6666
LEADER_TCP_BIND=127.0.0.1
LEADER_METRICS_PORT=9090
TOLERANCE_CONF=config/tolerance.conf

# ================= MEMBER =================
MEMBER_GRPC_PORT=5556
MEMBER_METRICS_PORT=9092
MEMBER_IO_MODE=buffered
# Optional: expected leader certificate CN for member-side auth check
MEMBER_EXPECTED_LEADER_CN=leader

# ================= BALANCER =================
# Options: least_loaded (default), p2c
BALANCER_STRATEGY=least_loaded

# ================= LAUNCHER =================
# Optional: override launcher base directory (defaults to current working directory)
# TOLEREX_BASE_DIR=D:\Tolerex
