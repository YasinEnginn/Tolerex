GRAFANA_ADMIN_PASSWORD=change-me

LEADER_ADDR=localhost:5555
LEADER_GRPC_PORT=5555
LEADER_TCP_PORT=6666
LEADER_TCP_BIND=127.0.0.1
LEADER_METRICS_PORT=9090
LEADER_STATS_INTERVAL=0
LEADER_EXPECTED_MEMBER_CN=member
LEADER_CERT_FILE=config/tls/leader.crt
LEADER_KEY_FILE=config/tls/leader.key
TOLERANCE_CONF=config/tolerance.conf

MEMBER_GRPC_PORT=5556
MEMBER_METRICS_PORT=9092
MEMBER_IO_MODE=buffered
MEMBER_ADDR=localhost:5556
MEMBER_EXPECTED_LEADER_CN=leader
MEMBER_CERT_FILE=config/tls/member.crt
MEMBER_KEY_FILE=config/tls/member.key

CA_CERT_FILE=config/tls/ca.crt

BALANCER_STRATEGY=least_loaded
TOLEREX_LOG_LEVEL=info
# Set TOLEREX_LOG_FILE=off when stderr is collected by the runtime.
# Leave it empty to write separate rotating files under logs/.
TOLEREX_LOG_FILE=
TOLEREX_LOG_DIR=logs

# Optional Windows launcher override when it is not started from the repository root.
# TOLEREX_BASE_DIR=D:\path\to\Dagitik_Mesaj_Kayit_Servisi
